# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./medwise.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/medwise
# Paid OpenAI key (prescription reading, symptom guide). Never commit or paste it anywhere.
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Rx Pad QR codes: a long random value (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Empty: the pad prints without QR codes. Changing it makes old QR codes show "Could not check".
RX_SIGNING_SECRET=
